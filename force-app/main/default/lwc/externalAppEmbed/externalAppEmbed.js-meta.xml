<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>External App Embed</masterLabel>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage,lightning__RecordPage">
            <supportedFormFactors>
                <supportedFormFactor type="Large"/>
                <supportedFormFactor type="Small"/>
            </supportedFormFactors>
            <property name="appUrl" type="String" default="https://plus-modify-mega-celebs.trycloudflare.com" label="App URL"/>
            <property name="height" type="Integer" default="60" label="Height (px)"/>
            <property name="shellTitle" type="String" default="External app" label="Title"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
